{
  "id": "telegram-public",
  "name": "Telegram públicos",
  "version": "1.1.2",
  "apiVersion": 6,
  "entry": "plugin.js",
  "description": "Reproduce vídeos de canales públicos de Telegram. Configura los usuarios de los canales (sin @) en Ajustes. Solo canales con vista pública.",
  "author": "kino-community",
  "homepage": "https://github.com/kinotvapp/kino-plugins",
  "icon": "icon.png",
  "hosts": [
    "t.me",
    "*.t.me",
    "telegram.me",
    "*.telegram.me",
    "telegram.org",
    "*.telegram.org",
    "cdn-telegram.org",
    "*.cdn-telegram.org",
    "telegram-cdn.org",
    "*.telegram-cdn.org",
    "telesco.me",
    "*.telesco.me"
  ],
  "streamHosts": "any",
  "capabilities": ["home", "search", "resolve"],
  "categories": ["movies", "series"],
  "color": "#2AABEE",
  "settings": [
    {
      "key": "channels",
      "label": "Canales públicos",
      "type": "list",
      "hint": "Usuario sin @ (ej: durov). Solo canales con vista pública.",
      "max": 25,
      "required": true,
      "fields": [
        {
          "key": "username",
          "label": "Usuario del canal",
          "type": "text",
          "required": true,
          "hint": "Sin @ ni t.me/"
        },
        {
          "key": "label",
          "label": "Nombre (opcional)",
          "type": "text",
          "hint": "Cómo se muestra en Inicio"
        }
      ]
    },
    {
      "key": "maxPerChannel",
      "label": "Vídeos por canal",
      "type": "select",
      "default": "20",
      "options": [
        { "value": "10", "label": "10" },
        { "value": "15", "label": "15" },
        { "value": "20", "label": "20" },
        { "value": "30", "label": "30" },
        { "value": "40", "label": "40" }
      ]
    },
    {
      "key": "pagesPerChannel",
      "label": "Páginas a cargar",
      "type": "select",
      "default": "2",
      "hint": "Cada página \~20 posts. Más = más historial.",
      "options": [
        { "value": "1", "label": "1 página" },
        { "value": "2", "label": "2 páginas" },
        { "value": "3", "label": "3 páginas" }
      ]
    }
  ]
}